# Environment Variable Reference
# Copy this file to .env.local and fill in the values.
# Never commit .env.local or any file containing real secrets.

# ── Database ────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string (pooled URL recommended for serverless)
DATABASE_URL=postgresql://neondb_owner:xxxxxx

# ── Better Auth ──────────────────────────────────────────────────────────────
# A long random secret used to sign sessions. Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=xxxxxxxxxxxxxxxxxxxxxxx

# The canonical base URL of your application (no trailing slash)
# Local:      http://localhost:3000
# Production: https://your-app.vercel.app
BETTER_AUTH_URL=xxxxxxxxxxxxxxxxxxx

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxx

# ── AI — Google Gemini ───────────────────────────────────────────────────────
# Create an API key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=AQ.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Dev only: lets your phone on the same Wi-Fi use the dev server
DEV_NETWORK_ORIGIN=http://192.168.x.x:3000
